// ============================================
// ReviewFunnel — Prisma Schema (PostgreSQL)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────
enum Plan {
  FREE
  PRO
  BUSINESS
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  plan                 Plan      @default(FREE)
  refreshToken         String?   @map("refresh_token")
  planExpiresAt        DateTime? @map("plan_expires_at")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  businessProfile BusinessProfile?

  @@map("users")
}

// ─────────────────────────────────────────────
// BUSINESS PROFILES (1:1 with User)
// ─────────────────────────────────────────────
model BusinessProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  businessName    String   @map("business_name")
  googleReviewUrl String?  @map("google_review_url")
  logoUrl         String?  @map("logo_url")
  primaryColor    String   @default("#6C63FF") @map("primary_color")
  tagline         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCodes   QrCode[]
  locations Location[]

  @@map("business_profiles")
}

// ─────────────────────────────────────────────
// LOCATIONS (Business plan)
// ─────────────────────────────────────────────
model Location {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  qrCodes QrCode[]

  @@index([profileId])
  @@map("locations")
}

// ─────────────────────────────────────────────
// QR CODES
// ─────────────────────────────────────────────
model QrCode {
  id              String   @id @default(uuid())
  profileId       String   @map("profile_id")
  locationId      String?  @map("location_id")
  slug            String   @unique
  name            String
  googleReviewUrl String   @map("google_review_url")
  funnelUrl       String   @map("funnel_url")
  isActive        Boolean  @default(true) @map("is_active")
  customization   Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile           BusinessProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  scanEvents        ScanEvent[]
  sentimentEvents   SentimentEvent[]
  reviewClickEvents ReviewClickEvent[]
  feedbacks         Feedback[]

  @@index([profileId])
  @@map("qr_codes")
}

// ─────────────────────────────────────────────
// SCAN EVENTS
// ─────────────────────────────────────────────
model ScanEvent {
  id        String   @id @default(uuid())
  qrCodeId  String   @map("qr_code_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  qrCode         QrCode          @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  sentimentEvent SentimentEvent?

  @@index([qrCodeId])
  @@map("scan_events")
}

// ─────────────────────────────────────────────
// SENTIMENT EVENTS
// ─────────────────────────────────────────────
model SentimentEvent {
  id          String    @id @default(uuid())
  qrCodeId    String    @map("qr_code_id")
  scanEventId String    @unique @map("scan_event_id")
  sentiment   Sentiment
  createdAt   DateTime  @default(now()) @map("created_at")

  qrCode           QrCode            @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scanEvent        ScanEvent         @relation(fields: [scanEventId], references: [id], onDelete: Cascade)
  reviewClickEvent ReviewClickEvent?
  feedback         Feedback?

  @@index([qrCodeId])
  @@map("sentiment_events")
}

// ─────────────────────────────────────────────
// REVIEW CLICK EVENTS
// ─────────────────────────────────────────────
model ReviewClickEvent {
  id               String   @id @default(uuid())
  qrCodeId         String   @map("qr_code_id")
  sentimentEventId String   @unique @map("sentiment_event_id")
  createdAt        DateTime @default(now()) @map("created_at")

  qrCode         QrCode         @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  sentimentEvent SentimentEvent @relation(fields: [sentimentEventId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@map("review_click_events")
}

// ─────────────────────────────────────────────
// FEEDBACK (private, captured from unhappy customers)
// ─────────────────────────────────────────────
model Feedback {
  id               String   @id @default(uuid())
  qrCodeId         String   @map("qr_code_id")
  sentimentEventId String   @unique @map("sentiment_event_id")
  rating           Int
  category         String?
  message          String?
  contactEmail     String?  @map("contact_email")
  isRead           Boolean  @default(false) @map("is_read")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  qrCode         QrCode         @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  sentimentEvent SentimentEvent @relation(fields: [sentimentEventId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@map("feedback")
}
